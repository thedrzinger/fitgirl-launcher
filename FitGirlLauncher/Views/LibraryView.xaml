<UserControl x:Class="FitGirlLauncher.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FitGirlLauncher.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolConverter x:Key="InvBool"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyStrToVis"/>
        <conv:StatusToVisibilityConverter x:Key="StatusToVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: refresh, search, count -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,12">
                <Button DockPanel.Dock="Left" Content="Refresh" MinWidth="92"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsScanning, Converter={StaticResource InvBool}}"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding GameCountText}"
                           VerticalAlignment="Center" Margin="14,0,6,0"
                           Foreground="{StaticResource SubTextBrush}"/>
                <Grid MinWidth="200" MaxWidth="420" Margin="12,0">
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Search games"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Margin="11,0,0,0"
                               Foreground="{StaticResource SubTextBrush}"
                               Visibility="{Binding SearchText, Converter={StaticResource EmptyStrToVis}}"/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Thin progress line while scanning -->
        <ProgressBar Grid.Row="1" Height="3" BorderThickness="0"
                     Background="Transparent" Foreground="{StaticResource AccentBrush}"
                     IsIndeterminate="True"
                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>

        <!-- Content area -->
        <Grid Grid.Row="2">

            <!-- Game grid -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding Status, Converter={StaticResource StatusToVis}, ConverterParameter=Ready}">
                <ItemsControl x:Name="GamesItems" ItemsSource="{Binding GamesView}" Margin="16">
                    <!-- Sections stack vertically (GroupStyle.Panel hosts the groups);
                         tiles wrap inside each section (the ItemsPanel is what
                         WPF uses for the items within each group).
                         Group order = first-appearance order = settings order. -->
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="16" FontWeight="SemiBold"
                                               Margin="0,12,0,2"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                            <GroupStyle.Panel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </GroupStyle.Panel>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TileButton}"
                                    Width="176" Margin="8"
                                    ToolTip="{Binding FolderName}"
                                    Command="{Binding DataContext.OpenGameCommand, Source={x:Reference GamesItems}}"
                                    CommandParameter="{Binding}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Height="216">
                                        <Image Source="{Binding ArtImage}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding HasArt, Converter={StaticResource BoolToVis}}"/>
                                        <Border Background="{StaticResource PanelBrush}"
                                                Visibility="{Binding HasArt, Converter={StaticResource InvBoolToVis}}">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="❖" FontSize="28" HorizontalAlignment="Center"
                                                           Foreground="{StaticResource SubTextBrush}"/>
                                                <TextBlock Text="No cover found" Margin="0,8,0,0" FontSize="11"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{StaticResource SubTextBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- cover-art loading spinner -->
                                        <Control Style="{StaticResource ArtSpinner}"
                                                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                                                 Visibility="{Binding ArtLoading, Converter={StaticResource BoolToVis}}"/>

                                        <!-- installed badge -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                                Background="#CC17181D" CornerRadius="4" Padding="6,2"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                         Fill="{StaticResource SuccessBrush}"/>
                                                <TextBlock Text="Installed" FontSize="11" Margin="5,0,0,0"
                                                           Foreground="{StaticResource SuccessBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- locate installed exe -->
                                        <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"
                                                Padding="8,3" FontSize="11"
                                                Content="Locate exe"
                                                ToolTip="Point at the installed game's .exe — its game page will then launch the game instead of the installer"
                                                Command="{Binding DataContext.LocateExeCommand, Source={x:Reference GamesItems}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding CleanTitle}"
                                               Margin="10,9,10,12"
                                               FontSize="13" FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               MaxHeight="34"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>

                                <Button.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Locate installed exe…"
                                                  Command="{Binding DataContext.LocateExeCommand, Source={x:Reference GamesItems}}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="Clear installed exe"
                                                  Command="{Binding DataContext.ClearExeCommand, Source={x:Reference GamesItems}}"
                                                  CommandParameter="{Binding}"
                                                  Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- No library set -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440"
                        Visibility="{Binding Status, Converter={StaticResource StatusToVis}, ConverterParameter=NotSet}">
                <TextBlock Text="No library folder set yet"
                           FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Margin="0,10,0,22" TextWrapping="Wrap" HorizontalAlignment="Center"
                           Foreground="{StaticResource SubTextBrush}"
                           Text="Point the launcher at the folders that hold your game folders (the ones with [FitGirl Repack] in the name) and your library will appear here."/>
                <Button Content="Open Settings" Style="{StaticResource PrimaryButton}"
                        Padding="18,9" HorizontalAlignment="Center"
                        Command="{Binding OpenSettingsCommand}"/>
            </StackPanel>

            <!-- Library unreachable -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480"
                        Visibility="{Binding Status, Converter={StaticResource StatusToVis}, ConverterParameter=Unreachable}">
                <TextBlock Text="Can't reach your library"
                           FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding StatusMessage}" Margin="0,10,0,22" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Foreground="{StaticResource SubTextBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Retry" Style="{StaticResource PrimaryButton}" Padding="18,9"
                            Command="{Binding RefreshCommand}"/>
                    <Button Content="Open Settings" Padding="18,9" Margin="10,0,0,0"
                            Command="{Binding OpenSettingsCommand}"/>
                </StackPanel>
            </StackPanel>

            <!-- No games found -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440"
                        Visibility="{Binding Status, Converter={StaticResource StatusToVis}, ConverterParameter=Empty}">
                <TextBlock Text="No games found"
                           FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" HorizontalAlignment="Center"
                           Foreground="{StaticResource SubTextBrush}"
                           Text="No folders with [FitGirl Repack] in the name were found in any of your library folders."/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
