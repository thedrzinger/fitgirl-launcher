<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Velopack uses this as the running app version (shown in Settings,
         compared against the GitHub releases). Bump it for each release. -->
    <Version>1.0.1</Version>
    <!-- We define our own Main() in App.xaml.cs so VelopackApp.Build().Run()
         can execute before WPF starts. -->
    <StartupObject>FitGirlLauncher.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.158" />
  </ItemGroup>

  <ItemGroup>
    <!-- App.xaml is compiled as a Page, not an ApplicationDefinition, so the
         build does NOT generate its own Main() — we need ours to run the
         Velopack bootstrap first. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

</Project>
